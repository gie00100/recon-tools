# ============================================================
# Recon Toolkit — Environment Configuration
# Copy this file to .env and fill in your API keys
# ============================================================

# ── OSINT API Keys ──────────────────────────────────────────
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
CERTSPOTTER_API_KEY=
SECURITYTRAILS_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
GITHUB_TOKEN=

# ── Discord Webhooks ────────────────────────────────────────
# [Recon-Bot-Status] Channel: scan start/stop alerts, summaries
DISCORD_WEBHOOK_URL=

# [Recon-Bot-Findings] Channel: vulnerabilities, exposed ports, credentials
DISCORD_RESULTS_WEBHOOK_URL=

# ── Rate Limiting (requests per second) ─────────────────────
RATE_LIMIT_DEFAULT=5
RATE_LIMIT_SECURITYTRAILS=5
RATE_LIMIT_CRTSH=2

# ── Concurrency ────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=50
DNS_CONCURRENCY=100

# ── Timeouts (seconds) ─────────────────────────────────────
HTTP_TIMEOUT=10
DNS_TIMEOUT=5

# ── Output ──────────────────────────────────────────────────
OUTPUT_DIR=output
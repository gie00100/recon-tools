[Unit]
Description=Recon Discord Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/recon-tools
ExecStart=/root/recon-tools/venv/bin/python /root/recon-tools/src/discord_bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
